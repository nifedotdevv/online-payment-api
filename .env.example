PORT=3000

POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
# Host port for the Docker DB (5432 is taken by local Postgres)
DB_PORT=5433

# Used when running the API outside Docker (compose sets its own)
DATABASE_URL=postgres://payments:change-me@localhost:5433/payments

# pgAdmin login (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Paystack secret key (dashboard > Settings > API Keys). Use sk_test_... in development.
PAYSTACK_SECRET_KEY=sk_test_change-me

# Where Paystack sends donors after paying; your frontend's thank-you page. Falls back to the dashboard callback URL.
PAYSTACK_CALLBACK_URL=http://localhost:5173/donation/complete
